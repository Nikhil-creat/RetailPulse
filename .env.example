# Copy to .env (NEVER commit .env). Generate a key with:  python -m retailpulse.cli make-key --name me --role admin
RP_ENV=prod
# format: name:sha256hash:role   (role = viewer | analyst | admin; comma-separate several keys)
RP_API_KEYS=admin:PASTE_SHA256_HASH_HERE:admin
RP_RATE_LIMIT_PER_MIN=120
RP_SQL_MAX_ROWS=200
RP_SQL_TIMEOUT_S=3

# Optional. Everything works without any of these (answers are then extractive, not LLM-written).
# ANTHROPIC_API_KEY=
# `python -m retailpulse.cli models` lists which of these hosted models are reachable:
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Only used by `export-static` (public site). Not secrets.
# RP_SITE_URL=https://your-domain.com
# RP_BASE_PATH=
# RP_CUSTOM_DOMAIN=

# Comma-separated exact origins allowed to call this API from a browser (e.g. the static website). Empty = CORS off. Never "*".
RP_CORS_ORIGINS=
# Origin of a live backend, used when exporting the static site (build time)
RP_API_URL=
