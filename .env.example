# Copy to .env (NEVER commit .env). Generate a key with:  python -m retailpulse.cli make-key
RP_ENV=prod
# format: name:sha256hash:role   (role = viewer | analyst | admin; comma-separate several keys)
RP_API_KEYS=admin:PASTE_SHA256_HASH_HERE:admin
# Optional: enables LLM-written answers; everything works without it
# ANTHROPIC_API_KEY=
RP_RATE_LIMIT_PER_MIN=120
RP_SQL_MAX_ROWS=200
RP_SQL_TIMEOUT_S=3
