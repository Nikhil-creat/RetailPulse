{
  // RetailPulse is a static site (Workers static assets, no Worker script).
  // Build step generates ./site ; `npx wrangler deploy` uploads it.
  "name": "retailpulse",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
