{
  "name": "RetailPulse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements-dev.txt && python -m retailpulse.cli run-all --quick",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "RetailPulse", "onAutoForward": "openPreview" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
